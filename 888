<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="สุ่มสาม">
  
  <!-- ดึงรูปไอคอนที่เราเตรียมไว้ -->
  <link rel="apple-touch-icon" href="icon.png">
  <link rel="icon" href="icon.png">

  <title>สุ่มสาม</title>
  <style>
    * { box-sizing: border-box; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
    body { font-family: 'Arial Black', Gadget, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; background: radial-gradient(circle, #2c1654 0%, #0c0517 100%); color: white; margin: 0; overflow: hidden; }
    .slot-cabinet { background: linear-gradient(180deg, #4a154b 0%, #110413 100%); padding: 30px 25px; border-radius: 35px; border: 5px solid #ffd700; box-shadow: 0 0 50px rgba(255, 215, 0, 0.3), inset 0 0 20px rgba(0, 0, 0, 0.8); position: relative; width: 340px; text-align: center; }
    .marquee { background: #111; border: 3px solid #f39c12; border-radius: 15px; padding: 10px; margin-bottom: 20px; box-shadow: 0 0 15px #f39c12; }
    .marquee h1 { margin: 0; font-size: 28px; color: #fff; text-shadow: 0 0 5px #fff, 0 0 10px #ff007f, 0 0 20px #ff007f; letter-spacing: 4px; }
    .reel-window { background: #000; border: 4px solid #b8860b; border-radius: 20px; padding: 15px 10px; display: flex; justify-content: space-between; gap: 10px; box-shadow: inset 0 0 20px rgba(0,0,0,1), 0 0 15px rgba(255,215,0,0.4); position: relative; }
    .reel { flex: 1; height: 120px; background: linear-gradient(180deg, #222 0%, #eee 25%, #fff 50%, #eee 75%, #222 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 70px; font-weight: 900; color: #111; box-shadow: inset 0 15px 15px rgba(0,0,0,0.8), inset 0 -15px 15px rgba(0,0,0,0.8); border: 1px solid #777; text-shadow: 2px 2px 0px rgba(255,255,255,0.8); }
    .control-panel { margin-top: 25px; }
    .spin-button { width: 100%; padding: 15px; font-size: 22px; font-weight: bold; color: #fff; background: linear-gradient(180deg, #e74c3c 0%, #c0392b 100%); border: none; border-radius: 50px; cursor: pointer; box-shadow: 0 6px 0 #922b21, 0 8px 15px rgba(0,0,0,0.6); transition: all 0.1s; text-transform: uppercase; letter-spacing: 2px; }
    .spin-button:active { transform: translateY(4px); box-shadow: 0 2px 0 #922b21, 0 4px 8px rgba(0,0,0,0.6); }
    .spin-button:disabled { background: #555; box-shadow: none; cursor: not-allowed; }
    .lever-container { position: absolute; right: -35px; top: 100px; width: 30px; height: 150px; cursor: pointer; }
    .lever-base { width: 20px; height: 50px; background: #444; border: 2px solid #aaa; border-radius: 0 10px 10px 0; position: absolute; bottom: 0; }
    .lever-rod { width: 10px; height: 100px; background: linear-gradient(90deg, #ccc, #fff, #888); position: absolute; left: 5px; bottom: 30px; transform-origin: bottom center; transition: transform 0.3s ease; border-radius: 5px; }
    .lever-ball { width: 35px; height: 35px; background: radial-gradient(circle at 10px 10px, #ff4d4d, #990000); border-radius: 50%; position: absolute; top: -20px; left: -12.5px; box-shadow: 0 4px 8px rgba(0,0,0,0.5); }
    .lever-container.pulled .lever-rod { transform: rotateX(60deg) scaleY(0.6); }
  </style>
</head>
<body>
  <div class="slot-cabinet">
    <div class="marquee"><h1>888</h1></div>
    <div class="reel-window">
      <div class="reel" id="reel1">0</div>
      <div class="reel" id="reel2">0</div>
      <div class="reel" id="reel3">0</div>
    </div>
    <div class="control-panel">
      <button class="spin-button" id="spinBtn" onclick="spin()">SPIN</button>
    </div>
    <div class="lever-container" id="lever" onclick="spin()">
      <div class="lever-base"></div>
      <div class="lever-rod"><div class="lever-ball"></div></div>
    </div>
  </div>
  <script>
    function spin() {
      const reel1 = document.getElementById('reel1');
      const reel2 = document.getElementById('reel2');
      const reel3 = document.getElementById('reel3');
      const btn = document.getElementById('spinBtn');
      const lever = document.getElementById('lever');
      if (btn.disabled) return;
      btn.disabled = true;
      lever.classList.add('pulled');
      setTimeout(() => { lever.classList.remove('pulled'); }, 400);
      let count = 0;
      const interval = setInterval(() => {
        reel1.textContent = Math.floor(Math.random() * 10);
        reel2.textContent = Math.floor(Math.random() * 10);
        reel3.textContent = Math.floor(Math.random() * 10);
        count++;
        if (count > 25) {
          clearInterval(interval);
          reel1.textContent = Math.floor(Math.random() * 10);
          reel2.textContent = Math.floor(Math.random() * 10);
          reel3.textContent = Math.floor(Math.random() * 10);
          btn.disabled = false;
        }
      }, 50);
    }
  </script>
</body>
</html>
